{
  "name": "nexrig-ai-pc-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:import": "tsx server/scripts/import-ryans.ts",
    "db:migrate": "docker compose exec -T postgres psql -U nexrig -d nexrig -f /docker-entrypoint-initdb.d/001-schema.sql",
    "db:migrate:remote": "tsx server/scripts/migrate.ts",
    "ai:ingest": "tsx server/scripts/ingest-manual.ts",
    "ai:eval": "tsx server/scripts/evaluate-ai.ts",
    "hf:verify": "tsx server/scripts/verify-hf.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.24",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "^22.4.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "concurrently": "latest",
    "tsx": "latest"
  }
}
